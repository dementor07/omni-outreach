# v2 frontend — multi-stage: build the React/Vite app, serve via nginx.
# The runtime nginx vhost is mounted from frontend/nginx.v2.conf via the
# compose file at /etc/nginx/nginx.conf, and proxies /api/* to backend-v2:8000.

# ── Stage 1: build ───────────────────────────────────────────────────────────
FROM node:20-alpine AS build
WORKDIR /app

# Install deps first so npm cache layer is reused
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

# Bring in source and build
COPY tsconfig.json vite.config.ts tailwind.config.ts postcss.config.js eslint.config.js index.html ./
COPY src/ ./src/
COPY public/ ./public/
RUN npm run build

# ── Stage 2: serve ───────────────────────────────────────────────────────────
FROM nginx:1.27-alpine
COPY nginx.v2.conf /etc/nginx/nginx.conf
COPY --from=build /app/dist/ /usr/share/nginx/html/
EXPOSE 80 443
