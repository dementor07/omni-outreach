{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true
  },
  "include": ["src"],
  "exclude": ["src/pages/_legacy", "src/pages/Campaigns", "src/pages/Campaigns.tsx", "src/pages/Dashboard.tsx", "src/pages/Approvals.tsx", "src/pages/StyleGuide.tsx"]
}
