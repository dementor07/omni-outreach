# Obsidian local app/runtime state (contains machine-local settings and secrets)
omni-vault/.obsidian/

# Claude Code — local MCP config (contains API keys)
.mcp.json
.claude/settings.local.json
.claude/skills/

# Gemini CLI — local MCP config (contains API keys)
.gemini/settings.json

# CodeGraph — local code-index (rebuilt per clone via `codegraph init`)
.codegraph/
GEMINI.md

# Local-only vault notes (credentials, machine-specific scratch) — never push
omni-vault/credentials.local.md
omni-vault/*.local.md
omni-vault/**/*.local.md

# One-off personal scripts that operate outside the repo
/clean_badges.py
/list_tables.py

# One-off browser/shell scratch generated during local verification
/apify-signin.png
/contacts_modal.yml
/*.stackdump
omni-vault/*.base

# Dead multi-LLM bridge/conference harness output (removed 2026-05-25)
.bridge_logs/
.bridge_context/
.conference_logs/

# Browser-verification scratch (Playwright MCP screenshots + snapshots)
.playwright-mcp/
/canvas-*.png
/editor-*.png
/palette-*.png
frontend/screenshots/
frontend/*.png
screenshots/

# Runtime TLS material copied into the production checkout by certbot hooks.
# Certificates are machine state, never source.
/certs/*.pem

# One-off UI test scratch
frontend/test-*.cjs

# Pre-v2 page snapshots kept locally for reference
/old_*.tsx
frontend/src/pages/_legacy/

# Architecture scratch diagrams (regenerated; not source of truth)
/node_structure_blueprint.*
/plugin_architecture_*
/sota_grid_structure.md
/python_tutorial/

# PMB local memory workspace marker (per-machine, never committed)
.pmb/

# Local agent-harness lease files (contain short-lived plaintext lease tokens)
.omni-harness/
