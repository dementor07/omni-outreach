# LOCAL-ONLY build override — NOT committed, NOT the real fix for RUST-001.
#
# The committed Dockerfile pins nightly and the repo's rust-toolchain.toml pins
# 1.83.0, but a floating transitive dep (toml_edit 0.25 / hashbrown) now requires
# the `edition2024` cargo feature, which 1.83 can't parse — so the real build is
# broken (this IS finding RUST-001). The proper fix is committing a Cargo.lock
# pinned to versions 1.83 can build.
#
# This override just gets the muscle running locally for the full-chain e2e +
# the System-pipeline visualisation, by building on a current stable Rust and
# dropping the 1.83 toolchain pin. It changes no committed source.
FROM rust:1.89-bookworm AS builder

RUN apt-get update && apt-get install -y pkg-config libssl-dev build-essential \
    zlib1g-dev libsasl2-dev libzstd-dev librdkafka-dev && rm -rf /var/lib/apt/lists/*

WORKDIR /usr/src/app
COPY . .
# Drop the 1.83 pin so the image's current stable toolchain is used.
RUN rm -f rust-toolchain.toml

RUN cargo build --release

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y libssl3 ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /usr/app
COPY --from=builder /usr/src/app/target/release/execution-engine .
CMD ["./execution-engine"]
